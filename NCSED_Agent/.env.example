# Скопируй в .env и заполни. .env в гит не попадает (см. .gitignore).
# Профиль определяет, какой адаптер используется в NCSED_Agent/llm/structured.py
# Допустимые значения: openai | ollama
LLM_PROFILE=openai

# --- Профиль openai (разработка на машине без GPU) ---
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Профиль ollama (запуск на ноуте с RTX 4050) ---
# LLM_PROFILE=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=EMPTY

# Ollama по умолчанию режет промпт до num_ctx МОЛЧА, без ошибки.
# Наши few-shot промпты длинные, поэтому значение задаём явно и проверяем.
LLM_NUM_CTX=16384

# Детерминизм для eval. Не гарантирует полной воспроизводимости, но снижает разброс.
LLM_TEMPERATURE=0.0
LLM_SEED=42

# --- Эмбеддинги и поиск ---
# Эмбеддер ВСЕГДА локальный, независимо от LLM_PROFILE: индекс привязан к модели,
# которой построен, и запрос надо кодировать той же самой. Облачный эмбеддер
# означал бы вызов API на каждый поиск — офлайн-демо на GPU-ноуте не работало бы.
# Выбор между моделями решается замером recall@k на наших данных (Ф2b), не бенчмарками.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Семейство e5 требует префиксов. Забыть их — тихая просадка качества без ошибки.
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_PASSAGE_PREFIX=passage:

QDRANT_PATH=./qdrant_storage

# --- Ресурсные гардрейлы ---
MAX_TOOL_ITERATIONS=8
NODE_TIMEOUT_SECONDS=300
